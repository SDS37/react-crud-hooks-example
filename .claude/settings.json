{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(CI=true npm test *)",
      "Bash(npm start)",
      "Bash(npm run start-server)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run format)",
      "Bash(npx prettier *)",
      "Bash(npx playwright *)",
      "Bash(npx ctx7@latest *)",
      "Bash(npx ctx7 *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh repo view *)",
      "mcp__codegraph__*"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh run cancel *)",
      "Bash(gh run delete *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)", "Edit(./.env)", "Edit(./.env.*)"]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["gh *", "git fetch *", "git pull *", "git push *"],
    "filesystem": {
      "allowWrite": ["~/.npm"]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.npmjs.org",
        "context7.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/secret-guard.py",
            "args": []
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-policy.py",
            "args": []
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-on-edit.py",
            "args": [],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/codegraph-prompt.py"
          }
        ]
      }
    ]
  }
}
