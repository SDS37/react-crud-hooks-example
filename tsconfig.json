{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "esnext"],
    // vitest and @testing-library/jest-dom both declare Assertion.
    "skipLibCheck": true,
    "rootDirs": [".", "./.react-router/types"],
    "types": ["node"]
  },
  "include": [
    ".react-router/types/**/*",
    "src/**/*",
    "server/**/*",
    "e2e/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "react-router.config.ts"
  ]
}
